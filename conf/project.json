{
  "ver1": {
    "name": "Sample App 1",
    "description": "示例应用 1 的配置，可从 HTTP 下载 APK。",
    "auto_get_apk": false,
    "apk_source": {
      "type": "http",
      "url": "https://github.com/example/app/releases/download/v1.0/app-v1.0.apk"
    }
  },
  "ver2": {
    "name": "Sample App 2",
    "description": "示例应用 2，支持从 Jenkins 拉取 APK。",
    "auto_get_apk": true,
    "apk_source": {
      "type": "jenkins",
      "url": "http://jenkins.example.com/job/app-v2/lastSuccessfulBuild/artifact/app-debug.apk",
      "auth": {
        "username": "jenkins_user",
        "password": "jenkins_api_token"
      }
    }
  },
  "stability_test": {
    "name": "车载端侧应用稳定性测试",
    "description": "包含系统健壮性、异常恢复与完整性能的稳定性测试方案。",
    "auto_get_apk": false,
    "modular_config": {
      "enabled_modules": [
        "system_robustness",
        "exception_recovery",
        "performance_all"
      ],
      "module_dependencies": {
        "system_robustness": [],
        "exception_recovery": ["mock_server"],
        "performance_response": [],
        "performance_resource": [],
        "performance_all": [],
        "broadcast_stress": [],
        "tts_stress": []
      }
    },
    "stability_config": {
      "long_stress": {
        "duration_hours": 12,
        "throttle": 700,
        "event_count": 100000
      },
      "performance": {
        "sample_interval": 30,
        "monitor_duration": 3600,
        "cold_start_threshold": 3.0,
        "response_delay_threshold": 1.5,
        "cpu_foreground_threshold": 30.0,
        "cpu_background_threshold": 1.0
      },
      "exception_recovery": {
        "network_disconnect_duration": 30,
        "weak_network_duration": 60,
        "mock_server_enabled": true,
        "network_proxy_enabled": true
      }
    }
  },
  "response_only_test": {
    "name": "仅响应性能测试",
    "description": "仅执行响应性能相关测试（冷启动、响应延迟等）。",
    "auto_get_apk": false,
    "modular_config": {
      "enabled_modules": ["performance_response"],
      "module_dependencies": {
        "performance_response": []
      }
    },
    "stability_config": {
      "performance": {
        "sample_interval": 30,
        "monitor_duration": 1800,
        "cold_start_threshold": 3.0,
        "response_delay_threshold": 1.5,
        "cpu_foreground_threshold": 30.0,
        "cpu_background_threshold": 1.0
      }
    }
  },
  "resource_only_test": {
    "name": "仅资源消耗测试",
    "description": "仅监控 CPU、内存等资源消耗。",
    "auto_get_apk": false,
    "modular_config": {
      "enabled_modules": ["performance_resource"],
      "module_dependencies": {
        "performance_resource": []
      }
    },
    "stability_config": {
      "performance": {
        "sample_interval": 30,
        "monitor_duration": 3600,
        "cold_start_threshold": 3.0,
        "response_delay_threshold": 1.5,
        "cpu_foreground_threshold": 30.0,
        "cpu_background_threshold": 1.0
      }
    }
  },
  "robustness_only_test": {
    "name": "仅系统健壮性测试",
    "description": "仅执行长时间压力与系统健壮性测试。",
    "auto_get_apk": false,
    "modular_config": {
      "enabled_modules": ["system_robustness"],
      "module_dependencies": {
        "system_robustness": []
      }
    },
    "stability_config": {
      "long_stress": {
        "duration_hours": 12,
        "throttle": 700,
        "event_count": 100000
      }
    }
  },
  "recovery_only_test": {
    "name": "仅异常恢复测试",
    "description": "仅执行异常恢复测试（网络断开、弱网、Mock 等）。",
    "auto_get_apk": false,
    "modular_config": {
      "enabled_modules": ["exception_recovery"],
      "module_dependencies": {
        "exception_recovery": ["mock_server"]
      }
    },
    "stability_config": {
      "exception_recovery": {
        "network_disconnect_duration": 30,
        "weak_network_duration": 60,
        "mock_server_enabled": true,
        "network_proxy_enabled": true
      }
    }
  },
  "broadcast_stress_test": {
    "name": "广播模式压力测试",
    "description": "通过 adb broadcast 发送 hint 调用目标应用能力。",
    "auto_get_apk": false,
    "modular_config": {
      "enabled_modules": ["broadcast_stress"],
      "module_dependencies": {
        "broadcast_stress": []
      }
    },
    "stability_config": {
      "broadcast_stress": {
        "duration_hours": 12,
        "interval_seconds": 30,
        "broadcast_action": "com.cei.llm.INPUT_HINT_TO_LLM",
        "hints": ["介绍一下白居易", "讲个笑话", "今天天气怎么样"],
        "hints_file": ""
      }
    }
  },
  "tts_stress_test": {
    "name": "TTS 模式压力测试",
    "description": "PC 端 TTS 播放语音，设备麦克风接收后触发应用响应。",
    "auto_get_apk": false,
    "modular_config": {
      "enabled_modules": ["tts_stress"],
      "module_dependencies": {
        "tts_stress": []
      }
    },
    "stability_config": {
      "tts_stress": {
        "duration_hours": 12,
        "interval_seconds": 30,
        "texts": ["打开设置", "介绍一下北京", "今天天气怎么样"],
        "texts_file": ""
      }
    }
  }
}
